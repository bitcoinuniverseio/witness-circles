{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.bitcoinuniverse.dev/witc/v1/context-manifest.schema.json",
  "title": "Witness Circles v1 context manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "version", "kind", "nonce", "title", "created", "expires"],
  "properties": {
    "protocol": { "const": "witc" },
    "version": { "const": 1 },
    "kind": { "const": "circle" },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "created": { "type": "string", "format": "date-time" },
    "expires": { "type": "string", "format": "date-time" },
    "orbit": { "type": "string", "minLength": 1, "maxLength": 96 },
    "host": { "type": "string", "minLength": 1, "maxLength": 256 },
    "media": { "type": "string", "minLength": 1, "maxLength": 512 },
    "description": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "renderer": { "type": "string", "minLength": 1, "maxLength": 256 },
    "aliases": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 }
        }
      }
    }
  }
}
