{
  "name": "@bitcoinuniverse/witness-circles",
  "version": "0.1.0",
  "description": "Independent reference implementation and SDK for the Witness Circles Bitcoin protocol",
  "type": "module",
  "license": "MIT",
  "private": false,
  "homepage": "https://github.com/bitcoinuniverse/witness-circles#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitcoinuniverse/witness-circles.git"
  },
  "bugs": {
    "url": "https://github.com/bitcoinuniverse/witness-circles/issues"
  },
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "keywords": [
    "bitcoin",
    "taproot",
    "psbt",
    "protocol",
    "witness-circles"
  ],
  "files": [
    "dist",
    "schemas",
    "test-vectors",
    "SPECIFICATION.md",
    "SECURITY.md",
    "README.md"
  ],
  "bin": {
    "witc": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/*": "./schemas/*",
    "./test-vectors/*": "./test-vectors/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src tests scripts site examples schemas package.json tsconfig.json tsconfig.build.json biome.json vitest.config.ts",
    "lint:fix": "biome check --write src tests scripts site examples schemas package.json tsconfig.json tsconfig.build.json biome.json vitest.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "content:check": "node scripts/check-content.mjs",
    "vectors:generate": "tsx scripts/generate-state-lifecycle-vector.ts",
    "vectors:verify": "npm run build && node dist/cli.js vectors verify",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run content:check && node dist/cli.js vectors verify",
    "prepack": "npm run verify"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.1",
    "@scure/btc-signer": "2.2.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "ajv": "8.20.0",
    "fast-check": "4.9.0",
    "happy-dom": "20.11.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
